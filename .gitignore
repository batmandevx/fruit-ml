# Python / tooling
__pycache__/
*.pyc
.pytest_cache/
.venv*/
.uv-cache/
.ipynb_checkpoints/
.DS_Store

# Datasets: third-party, ~8.5 GB. Re-create with the download/prepare scripts (see README).
data/

# Training logs and ad-hoc runs
outputs/logs/
outputs/predictions/
outputs/quality/reports/

# Model weights: only the production models (config.PRODUCTION_RUNS) are committed.
outputs/models/*
!outputs/models/*_meta.json
!outputs/models/*_calib.json
!outputs/models/*_tflite.json
!outputs/models/effv2b0_260_best.keras
!outputs/models/effv2b0_260_v2_best.keras
!outputs/models/grade_mnv3_best.keras
!outputs/models/grade_effv2b0_best.keras
!outputs/models/maturity_effv2b0_best.keras
!outputs/models/effv2b0_260.tflite
!outputs/models/effv2b0_260_v2.tflite
!outputs/models/grade_mnv3.tflite
!outputs/models/grade_effv2b0.tflite
!outputs/models/maturity_effv2b0.tflite
# PyTorch probes are small (~0.1 MB; the DINOv3 backbone is downloaded from Hugging Face)
!outputs/models/*_probe.joblib
# cached foundation-model embeddings (~0.6 GB, rebuilt by probe.py)
outputs/features/
